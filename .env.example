# ==============================================================================
# CertClerk LLM Configuration
# ==============================================================================
# Leave blank for deterministic Rules-Only mode (works 100% offline).
# Or choose one of the free presets below:

# --- PRESET 1: Google Gemini (Recommended - 100% Free, no credit card) ---
# Get key: https://aistudio.google.com/app/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-3.6-flash

# --- PRESET 2: Groq Cloud (Free, ultra-fast Llama 3.3 70B) ---
# Get key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# --- PRESET 3: Ollama (100% Local on your PC, completely private) ---
# Download: https://ollama.com (run: ollama run llama3.2)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=llama3.2

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ==============================================================================
# Storage & Pipeline Settings
# ==============================================================================
DATA_DIR=./data
RETENTION_HOURS=24
MAX_ROWS=2000
MAX_UPLOAD_MB=5
DEMO_MODE=false
SEND_DELAY_SECONDS=1.5
BACKEND_URL=http://localhost:8000
